  (text "GPIO PIN MAPPING:\nD0/A0=GPIO2 -> BATT_MON (R6/R7 divider)\nD1=GPIO3 -> RED_LEFT (R3)\nD2=GPIO4 -> YELLOW_RIGHT (R4)\nD3=GPIO5 -> RED_RIGHT (R5)\nD4=GPIO6 -> I2C SDA (ADXL345)\nD5=GPIO7 -> I2C SCL (ADXL345)\nD6=GPIO21 -> GREEN_LED (R1)\nD7=GPIO20 -> YELLOW_LEFT (R2)\nD10=GPIO10 -> POWER_SW\n3V3 -> ADXL345 VCC, decoupling caps\nGND -> all grounds"
    (at 60 170 0)
    (effects (font (size 1.5 1.5)))
  )

  (text "LED ARRANGEMENT (left to right):\n[RED_L][YELLOW_L][GREEN][YELLOW_R][RED_R]\n GPIO3  GPIO20  GPIO21  GPIO4   GPIO5\n  D1     D7      D6      D2      D3\nAll LEDs: 3mm THT, 100R series resistor\nVf ~2.0V red/yellow, ~2.2V green = ~13mA"
    (at 60 190 0)
    (effects (font (size 1.5 1.5)))
  )

  (text "BATTERY / POWER:\nLiPo 3.7V single cell via J1 (JST-PH 2-pin)\nSW1 slide switch in series with VBATT\nXIAO has onboard LiPo charger via USB-C\nVBAT monitored via GPIO2/A0\n100k/100k divider: max 2.1V at A0 for 4.2V cell\nXIAO ADC 11dB attenuation = 0-2.5V range"
    (at 60 208 0)
    (effects (font (size 1.5 1.5)))
  )

  (text "I2C / ADXL345:\nSDA=GPIO6 (D4) -> ADXL345 SDA\nSCL=GPIO7 (D5) -> ADXL345 SCL\nADXL345 CS pin tied to VCC (I2C mode)\nI2C address: 0x53 (ADDR pin to GND)\nPowered from 3.3V rail"
    (at 60 224 0)
